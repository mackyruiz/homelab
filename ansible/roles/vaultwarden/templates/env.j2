DOMAIN=https://{{ vaultwarden_fqdn }}
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
ADMIN_TOKEN='{{ vault_vaultwarden_admin_token_hash }}'
# SSO is an extra login option; master-password login stays on so the vault
# works while Authentik or FreeIPA is down.
SSO_ENABLED=true
SSO_ONLY=false
SSO_AUTHORITY=https://{{ authentik_fqdn }}/application/o/vaultwarden/
SSO_SCOPES=openid profile email offline_access
SSO_CLIENT_ID=vaultwarden
SSO_CLIENT_SECRET={{ vault_authentik_vaultwarden_client_secret }}
