SERVER_COUNTRIES={{ gluetun_server_countries }}
WIREGUARD_PRIVATE_KEY={{ vault_gluetun_wireguard_private_key | default('', true) }}
WIREGUARD_ADDRESSES={{ vault_gluetun_wireguard_addresses | default('', true) }}
OPENVPN_USER={{ vault_gluetun_openvpn_user | default('', true) }}
