#!/bin/sh
# Nightly K3s SQLite datastore backup. age-encrypted: the NFS share is world-readable.
set -eu
dest={{ k3s_backup_dir }}
stamp=$(date +%Y%m%dT%H%M%S)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
sqlite3 /var/lib/rancher/k3s/server/db/state.db ".backup '$work/state.db'"
cp /var/lib/rancher/k3s/server/token "$work/token"
mkdir -p "$dest"
tar -C "$work" -czf - state.db token | age -r '{{ k3s_age_public_key }}' > "$dest/k3s-$stamp.tar.gz.age.part"
mv "$dest/k3s-$stamp.tar.gz.age.part" "$dest/k3s-$stamp.tar.gz.age"
ls -1t "$dest"/k3s-*.tar.gz.age | tail -n +{{ k3s_backup_keep + 1 }} | xargs -r rm -f --
