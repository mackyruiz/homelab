version: 1
metadata:
  name: homelab - gitea
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs: { identifiers: { name: "Default - Provider authorization flow (implicit consent)" }, required: true }
  - model: authentik_blueprints.metaapplyblueprint
    attrs: { identifiers: { name: "Default - Provider invalidation flow" }, required: true }
  - model: authentik_blueprints.metaapplyblueprint
    attrs: { identifiers: { name: "System - OAuth2 Provider - Scopes" }, required: true }

  # Stock profile scope, except that the Gitea username is looked up in
  # gitea_username_map so an SSO user links to an existing local account.
  - model: authentik_providers_oauth2.scopemapping
    id: gitea-profile-scope
    identifiers: { name: "Gitea: profile" }
    attrs:
      scope_name: profile
      expression: |
        usernames = {{ gitea_username_map | to_json }}
        username = usernames.get(request.user.username, request.user.username)
        return {
            "name": request.user.name,
            "given_name": request.user.name,
            "preferred_username": username,
            "nickname": username,
            "groups": [group.name for group in request.user.ak_groups.all()],
        }

  - model: authentik_providers_oauth2.oauth2provider
    id: gitea-provider
    identifiers: { name: Gitea }
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      grant_types: [authorization_code, refresh_token]
      client_id: gitea
      client_secret: !Env AUTHENTIK_GITEA_CLIENT_SECRET
      redirect_uris:
        - { matching_mode: strict, url: "https://{{ gitea_fqdn }}/user/oauth2/{{ gitea_oauth_source_name }}/callback" }
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !KeyOf gitea-profile-scope

  - model: authentik_core.application
    identifiers: { slug: gitea }
    attrs:
      name: Gitea
      provider: !KeyOf gitea-provider
      meta_launch_url: "https://{{ gitea_fqdn }}"
