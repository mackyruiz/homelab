version: 1
metadata:
  name: homelab - opnsense
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs: { identifiers: { name: "Default - Provider authorization flow (implicit consent)" }, required: true }
  - model: authentik_blueprints.metaapplyblueprint
    attrs: { identifiers: { name: "Default - Provider invalidation flow" }, required: true }
  - model: authentik_blueprints.metaapplyblueprint
    attrs: { identifiers: { name: "System - OAuth2 Provider - Scopes" }, required: true }

  # os-sso (OPNsense plugin). The stock profile scope already carries `groups`.
  # No refresh_token grant: os-sso never uses refresh tokens. The signing key is the
  # asymmetric self-signed cert (RS256); os-sso refuses symmetric ID-token signatures.
  - model: authentik_providers_oauth2.oauth2provider
    id: opnsense-provider
    identifiers: { name: OPNsense }
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      grant_types: [authorization_code]
      client_id: opnsense
      client_secret: !Env AUTHENTIK_OPNSENSE_CLIENT_SECRET
      redirect_uris:
        - { matching_mode: strict, url: "{{ opnsense_gui_url }}/api/sso/oidc/callback" }
        - { matching_mode: strict, url: "{{ opnsense_gui_url }}/api/sso/oidc/loggedout", redirect_uri_type: logout }
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]

  - model: authentik_core.application
    id: opnsense-app
    identifiers: { slug: opnsense }
    attrs:
      name: OPNsense
      provider: !KeyOf opnsense-provider
      meta_launch_url: "{{ opnsense_gui_url }}"

  # Only the admin group may even reach the firewall. An expression policy instead of a
  # group binding, because the FreeIPA group exists only after the first LDAP sync.
  - model: authentik_policies_expression.expressionpolicy
    id: opnsense-admins-only
    identifiers: { name: "OPNsense: {{ sso_admin_group }} only" }
    attrs:
      expression: |
        return ak_is_group_member(request.user, name="{{ sso_admin_group }}")

  - model: authentik_policies.policybinding
    identifiers: { target: !KeyOf opnsense-app, policy: !KeyOf opnsense-admins-only }
    attrs: { order: 0 }
